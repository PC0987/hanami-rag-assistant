# Pick ONE provider and set its key (never commit real keys).
# Option A: Google Gemini (key from https://aistudio.google.com/api-keys)
GEMINI_API_KEY=your-key-here
# Option B: Anthropic Claude
# ANTHROPIC_API_KEY=your-key-here

# Optional settings
# LLM_PROVIDER=google            # or "anthropic"; if unset, it is chosen from whichever key is set
# LLM_MODEL=gemini-2.5-flash     # default: gemini-2.5-flash (Google) or claude-haiku-4-5-20251001 (Anthropic)
# JUDGE_MODEL=gemini-2.5-flash   # model that grades answers in run_eval.py (defaults to LLM_MODEL)
# CHUNK_SIZE=500
# TOP_K=3
# PROMPT_VERSION=v2
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# CORS_ORIGINS=http://localhost:5173
